# Copiar este archivo a .env y ajustar valores si es necesario.
# .env NO debe subirse al repositorio.

# PostgreSQL
POSTGRES_DB=playpredict_db
POSTGRES_USER=playpredict_user
POSTGRES_PASSWORD=playpredict_password
POSTGRES_PORT=5436

# Backend
BACKEND_PORT=8006

# Contraseña de los 3 ADMIN de desarrollo sembrados por el seeder (Sprint 8.5).
# Solo tiene efecto en Development. Si se deja vacío, el seeder usa un valor por
# defecto documentado (ver backend/Data/DataSeeder.cs) — nunca usar en producción.
DEV_ADMIN_PASSWORD=

# Activa el escenario idempotente de 20 participantes para probar Ranking Denso.
DEMO_SEED_RANKING_DENSE=false

# Company pública cuya apariencia se muestra en /login.
LOGIN_APPEARANCE_PUBLIC_COMPANY_ID=1

# Frontend
FRONTEND_PORT=5175
