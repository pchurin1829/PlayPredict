# Copiar como .env.loadtest antes de iniciar el entorno aislado.
# .env.loadtest esta ignorado por Git y no debe reutilizar credenciales reales.

LOADTEST_POSTGRES_DB=playpredict_loadtest
LOADTEST_POSTGRES_USER=playpredict_loadtest_user
LOADTEST_POSTGRES_PASSWORD=change-me-loadtest-db
LOADTEST_POSTGRES_PORT=55436

LOADTEST_BACKEND_PORT=18006
LOADTEST_JWT_KEY=change-me-loadtest-jwt-key-at-least-32-chars

# Seeder explicito: admite 1..10000 sin cambios de codigo.
LOADTEST_USER_COUNT=100
LOADTEST_USER_PASSWORD=change-me-loadtest-player

# Variables consumidas por k6.
LOADTEST_BASE_URL=http://backend-loadtest:8080
LOADTEST_LEAGUE_NAME=PLAYPREDICT LOADTEST OFFICIAL
LOADTEST_USER_INDEX=1
