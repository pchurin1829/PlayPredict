# PlayPredict — variables de PRODUCCIÓN (P2.2).
# Copiar a .env.production (NO versionado) y completar SIN commitear valores reales.
# .env.production.example sí se versiona, solo con placeholders.
#
# Uso local de validación: exportar las mismas variables en el shell en lugar
# de crear el archivo (ver docs/DEPLOY_PRODUCTION.md).

# Entorno y dominio
SITE_ADDRESS=:80
# En VPS con dominio real: SITE_ADDRESS=jugar.tu-dominio.com.ar
# (Caddy solicita Let's Encrypt automáticamente).
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# PostgreSQL (secretos: nunca en Git)
POSTGRES_DB=playpredict_db
POSTGRES_USER=playpredict_user
POSTGRES_PASSWORD=cambiar-por-valor-aleatorio-largo

# JWT (P2.1: obligatorio en Production, mínimo 32 bytes aleatorios).
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
Jwt__Key=cambiar-por-clave-aleatoria-de-64-hex-o-mas
Jwt__Issuer=PlayPredict
Jwt__Audience=PlayPredict
Jwt__ExpiresMinutes=60

# Red interna predecible para ForwardedHeaders KnownNetworks (ver compose prod).
# El rate limiting por IP depende de que el proxy sea la única fuente confiable.
Forwarded__KnownNetworks=10.20.0.0/24

# CORS productivo. Con same-origin (Caddy sirve / y /api) puede quedar vacío.
# Solo completar si algún origen cruzado legítimo lo requiere (https, sin localhost).
Cors__Origins=
