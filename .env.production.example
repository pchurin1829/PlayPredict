# Plantilla sin secretos. Completar solo en el VPS, chmod 600.
PROXY_BIND_IP=127.0.0.1
PROXY_HTTP_PORT=8089

# Obligatorios: elegir DESPUES de auditar Docker, LAN y VPN del VPS.
# Ejemplo ilustrativo, NO reserva: subnet 10.203.89.0/24,
# gateway 10.203.89.1 y proxy 10.203.89.10. No usar si se superpone.
PROD_SUBNET=
PROD_GATEWAY=
PROD_PROXY_IP=

POSTGRES_DB=playpredict_db
POSTGRES_USER=playpredict_user
POSTGRES_PASSWORD=
# Generar cada secreto por separado: openssl rand -hex 32
Jwt__Key=
Jwt__Issuer=PlayPredict
Jwt__Audience=PlayPredict
Jwt__ExpiresMinutes=60

# Vacio para SPA y API del mismo origen HTTPS.
Cors__Origins=
