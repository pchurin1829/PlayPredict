# EJEMPLO: sustituir dominio y certificados antes de instalar.
# Sitio separado; no editar BAMIRA ni usar default_server.
server {
    listen 80;
    listen [::]:80;
    server_name jugar.example.com;
    return 301 https://jugar.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name jugar.example.com;
    ssl_certificate /etc/letsencrypt/live/jugar.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/jugar.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Sobrescribir entradas del cliente: no usar proxy_add_x_forwarded_for.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
