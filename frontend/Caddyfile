# HTTP interno: Nginx del host termina HTTPS.
{
	auto_https off
	servers {
		trusted_proxies static {$NGINX_TRUSTED_PROXY:127.0.0.1}
		trusted_proxies_strict
	}
}

:80 {
	encode gzip
	log
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Incluye uploads; conserva el prefijo /api.
	handle /api/* {
		reverse_proxy backend:8080 {
			# Una IP validada: ASP.NET consume un salto (ForwardLimit=1).
			header_up X-Forwarded-For {client_ip}
			header_up -Forwarded
		}
	}

	handle /swagger* {
		respond "Not Found" 404
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
