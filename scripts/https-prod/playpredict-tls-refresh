#!/usr/bin/python3 -IBS
"""Root-only: compare PUBLIC certificates, validate Nginx, reload only if needed."""
import os
from pathlib import Path
import socket
import ssl
import subprocess
import sys
import time

HOST = 'prode.odusport.com'
CERT = Path('/etc/letsencrypt-playpredict/live/prode.odusport.com/cert.pem')
ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'HOME': '/root', 'LANG': 'C', 'LC_ALL': 'C'}


def served_certificate():
    # Verify public chain and hostname; never disable verification to claim success.
    context = ssl.create_default_context()
    with socket.create_connection(('127.0.0.1', 443), timeout=5) as sock:
        with context.wrap_socket(sock, server_hostname=HOST) as tls:
            return tls.getpeercert(binary_form=True)


def matches(expected):
    try:
        return served_certificate() == expected
    except (OSError, ssl.SSLError):
        return False


def refresh():
    # cert.pem is public; privkey.pem and ACME account keys are never read here.
    expected = ssl.PEM_cert_to_DER_cert(CERT.read_text(encoding='ascii'))
    if matches(expected):
        print('PASS: certificate already served; no reload')
        return
    subprocess.run(('/usr/sbin/nginx', '-t', '-q'), env=ENV, cwd='/',
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=15, check=True)
    subprocess.run(('/usr/bin/systemctl', 'reload', 'nginx'), env=ENV, cwd='/',
                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=30, check=True)
    for _ in range(6):
        if matches(expected):
            print('PASS: new certificate served after validated Nginx reload')
            return
        time.sleep(2)
    raise RuntimeError('certificate-not-served')


if __name__ == '__main__':
    try:
        if len(sys.argv) != 1 or os.geteuid() != 0:
            raise RuntimeError('root-no-arguments-required')
        refresh()
    except Exception:
        print('FAIL: TLS refresh; administrator must inspect Nginx and certificate status', file=sys.stderr)
        sys.exit(1)
